# Copy to .env.local and fill in. .env.local is git-ignored; this file isn't,
# so never put real values here.

# Required. Mapbox access token (https://account.mapbox.com/access-tokens/).
# Server-only: the /api/mapbox proxy adds it to Mapbox requests. Don't rename it
# to NEXT_PUBLIC_..., or Next.js would send it to the browser.
MAPBOX_TOKEN=

# Optional. User-Agent for the server's Wikipedia requests. Wikimedia asks
# clients to include contact details, e.g.:
# WIKIMEDIA_USER_AGENT=mapbox-interactive/0.1 (https://example.com; you@example.com)
